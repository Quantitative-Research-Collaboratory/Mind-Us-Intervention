# nval = sample size, kval = number of variables, rho = population correlation, nsims = number of simulations
nval <- 20 #can change to make power higher if/when needed
#to get a more normative dataset when looking at cor or other stuff where the sample being more predictable is needed, increse n by alot.
kval <- 8
rho <- 0.1
#cant set roh to 1 bc cholesky wont work, but can set to like .99 to test the same thing i think? cant be sure bc my code still isnt working lol
nsims <- 1000
empties <- vector(length = nsims) #MAY WANNA RENAME FOR.LOOP.OUTPUT?
for(i in 1:nsims){
xsample <- matrix(rnorm(nval*kval, mean = 0, sd = 1), ncol = kval)#renamed to xsample, generating a sample of random numbers/data
rhomat<- matrix(data= rho, nrow = kval, ncol = kval)
diag(rhomat)<-1#this is making a matrix of all rho and then setting the dig to 1
#this also seems to be operating correctly and making a matrix of the rho w 1s on the diag
#next we do this: multiply x by the Cholesky decomposition of rhomat, gives data with rough correlation of rho
crhomat<-chol(rhomat)#doing the cholesky decomp and making a trigular matrix (so half 0s)
dcmpdX<-xsample%*%crhomat#renamed X dcmpdX (decomped)
#compute correlation matrix for data X*/
corX<- cor(dcmpdX)
#can use upper.tri(corX)*corX to only goet half of the matrix on the diagonal!
#compute p values for each correlation, but computing T statistic, then computing p from the T*/
perm<-corX[sample(ncol(corX)),] #making the permuted data set by shuffeling the cols
perm
}
